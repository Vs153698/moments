{
  "name": "@moments/db",
  "version": "0.0.0",
  "private": true,
  "description": "Database schema (Drizzle), migrations and seed for Moments. PostgreSQL + PostGIS.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "lint": "eslint src",
    "migrate": "drizzle-kit migrate",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts"
}
