{
  "name": "@moments/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Moments design system: tokens (colour, type, spacing, radius) consumed by mobile and web (F2 / KAN-28).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./global.css": "./src/global.css"
  },
  "files": [
    "dist",
    "src/global.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "gen:css": "tsx scripts/gen-css.ts",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "@types/react-test-renderer": "^19.3.0",
    "nativewind": "^4.1.23",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-test-renderer": "18.3.1",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
