# Moments — environment template. Copy to .env and fill in per environment (see docs/ENVIRONMENTS.md, F8 / KAN-27).

# Database
DATABASE_URL=postgres://moments:moments@localhost:5432/moments

# Redis (rate limiting, queues, realtime)
REDIS_URL=redis://localhost:6379

# API
PORT=3000
NODE_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=info

# Observability (all optional — wiring is no-op when unset, see docs/ENVIRONMENTS.md)
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
BETTERSTACK_SOURCE_TOKEN=
