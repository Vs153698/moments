# Moments — environment template. Copy to .env and fill in per environment (see docs/ENVIRONMENTS.md, F8 / KAN-27).

# Database
DATABASE_URL=postgres://moments:moments@localhost:5432/moments

# Redis (rate limiting, queues, realtime)
REDIS_URL=redis://localhost:6379

# API
PORT=3000
NODE_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=info

# Observability (all optional — wiring is no-op when unset, see docs/ENVIRONMENTS.md)
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
BETTERSTACK_SOURCE_TOKEN=

# Auth / OTP (C1.2, KAN-112) — secrets stay in env only, never commit real values
# HMAC secret for session tokens. Ephemeral per boot when empty (dev). REQUIRED in production.
OTP_JWT_SECRET=
# MSG91 (production SMS; pending KAN-101 account + DLT template)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5
# true = API returns the OTP in the response for on-screen display (dev testing only)
DEV_OTP_ON_SCREEN=true
