{
  "name": "@moments/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Moments mobile app (Expo, SDK 52). App shell + theming from F2 (KAN-28); route tree lands in F7 (KAN-30).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
